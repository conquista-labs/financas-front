# Exemplo de variáveis de ambiente do frontend.
# Copie para .env.loc / .env.dev / .env.hml / .env.prd e preencha os valores.
# NUNCA commite os .env com valores — eles estão no .gitignore.

# URL da API por ambiente (ex.: http://localhost:3001 no loc; a URL do Render em prd).
VITE_API_URL=http://localhost:3001

# Google OAuth (client id é público por natureza).
VITE_GOOGLE_CLIENT_ID=

# Bypass de login para validação visual local (nunca true em prod).
VITE_SKIP_AUTH=false
